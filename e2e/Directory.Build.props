<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- A long-lived compiler server could keep serving a previously built compiler. -->
    <UseSharedCompilation>false</UseSharedCompilation>
    <UsePatchedCompiler Condition="'$(UsePatchedCompiler)' == ''">true</UsePatchedCompiler>
  </PropertyGroup>

  <!-- Generated by scripts/build-compiler.sh; defines PatchedCompilerVersion. -->
  <Import Project="PatchedCompiler.props" Condition="Exists('$(MSBuildThisFileDirectory)PatchedCompiler.props')" />

  <!--
    Only the compiler binaries are used. The package's own MSBuild task targets a newer MSBuild
    than SDK 10.0.1xx ships, so the SDK's Csc task is redirected to it in Directory.Build.targets.
  -->
  <ItemGroup Condition="'$(UsePatchedCompiler)' == 'true'">
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="$(PatchedCompilerVersion)" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="EnsurePatchedCompilerVersion" BeforeTargets="Restore;_GenerateRestoreProjectSpec;CollectPackageReferences" Condition="'$(PatchedCompilerVersion)' == ''">
    <Error Text="PatchedCompilerVersion is not set. Run scripts/build-compiler.sh first." />
  </Target>
</Project>
